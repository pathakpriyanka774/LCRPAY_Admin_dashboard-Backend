# =====================================================
# LCRpay Admin Dashboard - Environment Configuration
# =====================================================

# ============================================
# REQUIRED SETTINGS (PRODUCTION & LOCAL)
# ============================================
SECRET_KEY=your-secret-key-here-min-32-chars-change-this-in-production
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# ============================================
# DATABASE CONFIGURATION
# ============================================
# For Local Development: Comment out DATABASE_URL to use SQLite
# SQLite database will be created automatically as: ./lcrpay.db

# For Production/PostgreSQL: Uncomment and configure below
# DATABASE_URL=postgresql://user:password@localhost:5432/lcrpay
# DATABASE_URL=postgresql://user:password@host.docker.internal:5432/lcrpay

# 🔗 PostgreSQL Database Connection
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# 🔐 JWT Authentication
# JWT_ALGORITHM=HS256 # This line seems to be removed from the changes, keeping it here for context but it's not in the provided changes.
ACCESS_TOKEN_EXPIRE_MINUTES=180

# 👤 Admin Credentials (REQUIRED - Change in production!)
# ADMIN_USERNAME=your_admin_username # This line seems to be removed from the changes, keeping it here for context but it's not in the provided changes.
# ADMIN_PASSWORD=your_secure_password # This line seems to be removed from the changes, keeping it here for context but it's not in the provided changes.

# 📁 File Upload Settings
UPLOAD_FOLDER=./uploads
STATIC_URL_PATH=/uploads

# ⚙️ API Configuration
PROJECT_NAME=LCRpay Admin Dashboard
VERSION=1.0.0